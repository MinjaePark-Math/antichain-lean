/-! Actual empirical probability measures and finite continuous descriptions
of weak neighborhoods. -/

noncomputable section

namespace Antichain

open Set Filter MeasureTheory Metric
open scoped Topology ENNReal BoundedContinuousFunction

def empiricalCubeMeasure (n d : ℕ) (x : CubeSample n d) : Measure (CubePoint d) :=
  if n = 0 then Measure.dirac 0 else (n : ℝ≥0∞)⁻¹ • ∑ j, Measure.dirac (x j)

theorem empiricalCubeMeasure_isProbabilityMeasure (n d : ℕ) (x : CubeSample n d) :
    IsProbabilityMeasure (empiricalCubeMeasure n d x) := by
  classical
  by_cases hn : n = 0
  · simp only [empiricalCubeMeasure, if_pos hn]
    infer_instance
  · refine ⟨?_⟩
    simp only [empiricalCubeMeasure, if_neg hn, Measure.smul_apply, Measure.finset_sum_apply,
      Measure.dirac_apply_of_mem (mem_univ _), Finset.sum_const, Finset.card_univ,
      Fintype.card_fin, nsmul_eq_mul, mul_one]
    exact ENNReal.inv_mul_cancel (Nat.cast_ne_zero.mpr hn) (by simp)

def empiricalCubeProbability (n d : ℕ) (x : CubeSample n d) : ProbabilityMeasure (CubePoint d) :=
  ⟨empiricalCubeMeasure n d x, empiricalCubeMeasure_isProbabilityMeasure n d x⟩

def limitingCubeProbability (d : ℕ) : ProbabilityMeasure (CubePoint d) :=
  ⟨limitingAntichainMeasure (Fin d), inferInstance⟩

theorem empiricalCubeProbability_integral (n d : ℕ) (hn : 0 < n) (x : CubeSample n d)
    (g : CubePoint d →ᵇ ℝ) :
    ∫ u, g u ∂(empiricalCubeProbability n d x : Measure (CubePoint d)) =
      (∑ j, g (x j)) / (n : ℝ) := by
  classical
  change ∫ u, g u ∂empiricalCubeMeasure n d x = _
  rw [empiricalCubeMeasure, if_neg hn.ne', integral_smul_measure,
    integral_finset_sum_measure (fun j _ => g.integrable (μ := Measure.dirac (x j)))]
  simp only [integral_dirac, ENNReal.toReal_inv, ENNReal.toReal_natCast, smul_eq_mul, div_eq_mul_inv]
  exact mul_comm _ _

theorem empiricalCubeProbability_continuous (n d : ℕ) :
    Continuous (empiricalCubeProbability n d) := by
  by_cases hn : n = 0
  · subst n
    have heq : empiricalCubeProbability 0 d =
        (fun _ => (⟨Measure.dirac 0, inferInstance⟩ : ProbabilityMeasure (CubePoint d))) := by
      funext x
      apply Subtype.ext
      rfl
    rw [heq]
    exact continuous_const
  · apply continuous_iff_continuousAt.mpr
    intro x
    apply ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mpr
    intro g
    simp_rw [empiricalCubeProbability_integral n d (Nat.pos_of_ne_zero hn)]
    apply Continuous.tendsto
    exact (continuous_finset_sum _ (fun j _ => g.continuous.comp (continuous_apply j))).div_const _

section WeakNeighborhoods

variable {E : Type*} [TopologicalSpace E] [MeasurableSpace E] [OpensMeasurableSpace E]

/-- The genuine weak neighborhood filter is generated by the actual bounded
continuous test integrals. -/
theorem probability_nhds_eq_test_iInf (mu : ProbabilityMeasure E) :
    𝓝 mu = ⨅ g : E →ᵇ ℝ,
      Filter.comap (fun nu : ProbabilityMeasure E => ∫ x, g x ∂nu)
        (𝓝 (∫ x, g x ∂mu)) := by
  apply le_antisymm
  · apply le_iInf
    intro g
    rw [← tendsto_iff_comap]
    exact (ProbabilityMeasure.continuous_integral_boundedContinuousFunction g).continuousAt
  · change Tendsto (fun nu : ProbabilityMeasure E => nu)
      (⨅ g : E →ᵇ ℝ, Filter.comap (fun nu : ProbabilityMeasure E => ∫ x, g x ∂nu)
        (𝓝 (∫ x, g x ∂mu))) (𝓝 mu)
    apply ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mpr
    intro g
    exact tendsto_comap.mono_left (iInf_le _ g)

/-- Every actual weak neighborhood contains conditions on finitely many
bounded continuous tests with positive tolerances. -/
theorem finite_tests_of_weak_neighborhood (mu : ProbabilityMeasure E)
    {U : Set (ProbabilityMeasure E)} (hU : U ∈ 𝓝 mu) :
    ∃ I : Finset (E →ᵇ ℝ), ∃ ε : (E →ᵇ ℝ) → ℝ,
      (∀ g ∈ I, 0 < ε g) ∧
      ∀ nu : ProbabilityMeasure E,
        (∀ g ∈ I, |(∫ x, g x ∂nu) - ∫ x, g x ∂mu| < ε g) → nu ∈ U := by
  classical
  rw [probability_nhds_eq_test_iInf] at hU
  have hb := Filter.HasBasis.iInf' (fun g : E →ᵇ ℝ =>
    (Metric.nhds_basis_ball : (𝓝 (∫ x, g x ∂mu)).HasBasis (fun r : ℝ => 0 < r)
      (fun r => ball (∫ x, g x ∂mu) r)).comap
        (fun nu : ProbabilityMeasure E => ∫ x, g x ∂nu))
  obtain ⟨⟨I, ε⟩, ⟨hI, hε⟩, hsub⟩ := hb.mem_iff.mp hU
  refine ⟨hI.toFinset, ε, fun g hg => hε g (hI.mem_toFinset.mp hg), ?_⟩
  intro nu hnu
  apply hsub
  apply Set.mem_iInter₂.mpr
  intro g hg
  change (∫ x, g x ∂nu) ∈ ball (∫ x, g x ∂mu) (ε g)
  simpa only [mem_ball, Real.dist_eq] using hnu g (hI.mem_toFinset.mpr hg)

end WeakNeighborhoods

/-- A finite union of genuinely exponentially small events is exponentially
small, uniformly in the varying finite-sample probability spaces. -/
theorem finite_union_exponential_tail {I : Type*} [Fintype I]
    {Ω : ℕ → Type*} [∀ n, MeasurableSpace (Ω n)]
    (law : ∀ n, Measure (Ω n)) (A : I → ∀ n, Set (Ω n))
    (hA : ∀ i, ∃ α : ℝ, 0 < α ∧ ∀ᶠ n : ℕ in atTop,
      law n (A i n) ≤ ENNReal.ofReal (Real.exp (-α * (n : ℝ)))) :
    ∃ α : ℝ, 0 < α ∧ ∀ᶠ n : ℕ in atTop,
      law n (⋃ i, A i n) ≤ ENNReal.ofReal (Real.exp (-α * (n : ℝ))) := by
  classical
  by_cases hI : IsEmpty I
  · letI := hI
    exact ⟨1, zero_lt_one, Eventually.of_forall (fun n => by simp)⟩
  haveI : Nonempty I := not_isEmpty_iff.mp hI
  choose α hα htail using hA
  let a := Finset.univ.inf' Finset.univ_nonempty α
  have ha : 0 < a := (Finset.lt_inf'_iff Finset.univ_nonempty).mpr (fun i _ => hα i)
  have hai (i : I) : a ≤ α i := Finset.inf'_le _ (Finset.mem_univ i)
  let M : ℝ := Fintype.card I
  have hM : 0 < M := by
    dsimp [M]
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card I)
  have hlarge : ∀ᶠ n : ℕ in atTop, 2 * Real.log M / a ≤ (n : ℝ) :=
    tendsto_natCast_atTop_atTop.eventually (eventually_ge_atTop _)
  refine ⟨a / 2, half_pos ha, ?_⟩
  filter_upwards [Filter.eventually_all.mpr htail, hlarge] with n hn hlarge
  have hscalar : M * Real.exp (-a * (n : ℝ)) ≤ Real.exp (-(a / 2) * (n : ℝ)) := by
    calc
      _ = Real.exp (Real.log M - a * (n : ℝ)) := by
        rw [sub_eq_add_neg, Real.exp_add, Real.exp_log hM]
        simp only [neg_mul]
      _ ≤ _ := Real.exp_le_exp.mpr (by
        have hl := (div_le_iff₀ ha).mp hlarge
        nlinarith)
  calc
    law n (⋃ i, A i n) ≤ ∑' i, law n (A i n) := measure_iUnion_le _
    _ = ∑ i, law n (A i n) := tsum_fintype _
    _ ≤ ∑ _ : I, ENNReal.ofReal (Real.exp (-a * (n : ℝ))) := by
      apply Finset.sum_le_sum
      intro i _
      apply (hn i).trans
      apply ENNReal.ofReal_le_ofReal
      apply Real.exp_le_exp.mpr
      simpa only [neg_mul] using neg_le_neg
        (mul_le_mul_of_nonneg_right (hai i) (Nat.cast_nonneg n))
    _ = ENNReal.ofReal (M * Real.exp (-a * (n : ℝ))) := by
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        ENNReal.ofReal_mul (by positivity : 0 ≤ M)]
      simp only [M, ENNReal.ofReal_natCast]
    _ ≤ _ := ENNReal.ofReal_le_ofReal hscalar

section Concentration

variable {E : Type*} [TopologicalSpace E] [MeasurableSpace E] [OpensMeasurableSpace E]
    {Ω : ℕ → Type*} [∀ n, MeasurableSpace (Ω n)]

/-- Exponential concentration for every bounded continuous test implies
exponential concentration in every actual weak neighborhood. -/
theorem weak_concentration_of_test_tails (law : ∀ n, Measure (Ω n))
    (X : ∀ n, Ω n → ProbabilityMeasure E) (mu : ProbabilityMeasure E)
    (hTest : ∀ g : E →ᵇ ℝ, ∀ ε : ℝ, 0 < ε → ∃ α : ℝ, 0 < α ∧
      ∀ᶠ n : ℕ in atTop,
        law n {ω | ε ≤ |(∫ x, g x ∂X n ω) - ∫ x, g x ∂mu|} ≤
          ENNReal.ofReal (Real.exp (-α * (n : ℝ))))
    {U : Set (ProbabilityMeasure E)} (hU : U ∈ 𝓝 mu) :
    ∃ α : ℝ, 0 < α ∧ ∀ᶠ n : ℕ in atTop,
      law n {ω | X n ω ∉ U} ≤ ENNReal.ofReal (Real.exp (-α * (n : ℝ))) := by
  classical
  obtain ⟨I, ε, hε, hsub⟩ := finite_tests_of_weak_neighborhood mu hU
  let A : I → ∀ n, Set (Ω n) := fun g n =>
    {ω | ε g.val ≤ |(∫ x, g.val x ∂X n ω) - ∫ x, g.val x ∂mu|}
  obtain ⟨α, hα, htail⟩ := finite_union_exponential_tail law A
    (fun g => hTest g.val (ε g.val) (hε g.val g.property))
  refine ⟨α, hα, htail.mono (fun n hn => (measure_mono ?_).trans hn)⟩
  intro ω hω
  by_contra hn
  apply hω
  apply hsub
  intro g hg
  by_contra hng
  exact hn (Set.mem_iUnion.mpr ⟨⟨g, hg⟩, not_lt.mp hng⟩)

variable [HasOuterApproxClosed E]

/-- The actual portmanteau implication is local at the limiting measure,
so it supplies a fixed weak neighborhood for every continuity set. -/
theorem continuity_set_weak_neighborhood (mu : ProbabilityMeasure E) {A : Set E}
    (hA : (mu : Measure E) (frontier A) = 0) {ε : ℝ} (hε : 0 < ε) :
    ∃ U : Set (ProbabilityMeasure E), U ∈ 𝓝 mu ∧
      ∀ nu ∈ U, |((nu : Measure E) A).toReal - ((mu : Measure E) A).toReal| < ε := by
  have hm := ProbabilityMeasure.tendsto_measure_of_null_frontier_of_tendsto'
    (tendsto_id : Tendsto (fun nu : ProbabilityMeasure E => nu) (𝓝 mu) (𝓝 mu)) hA
  have hr := (ENNReal.tendsto_toReal (measure_ne_top (mu : Measure E) A)).comp hm
  refine ⟨{nu | |((nu : Measure E) A).toReal - ((mu : Measure E) A).toReal| < ε}, ?_,
    fun _ h => h⟩
  exact hr.eventually (by simpa only [mem_ball, Real.dist_eq] using
    (Metric.ball_mem_nhds (((mu : Measure E) A).toReal) hε))

theorem continuity_set_concentration_of_weak (law : ∀ n, Measure (Ω n))
    (X : ∀ n, Ω n → ProbabilityMeasure E) (mu : ProbabilityMeasure E)
    (hWeak : ∀ U : Set (ProbabilityMeasure E), U ∈ 𝓝 mu →
      ∃ α : ℝ, 0 < α ∧ ∀ᶠ n : ℕ in atTop,
        law n {ω | X n ω ∉ U} ≤ ENNReal.ofReal (Real.exp (-α * (n : ℝ))))
    {A : Set E} (hA : (mu : Measure E) (frontier A) = 0) {ε : ℝ} (hε : 0 < ε) :
    ∃ α : ℝ, 0 < α ∧ ∀ᶠ n : ℕ in atTop,
      law n {ω | ε ≤ |((X n ω : Measure E) A).toReal - ((mu : Measure E) A).toReal|} ≤
        ENNReal.ofReal (Real.exp (-α * (n : ℝ))) := by
  obtain ⟨U, hU, hbound⟩ := continuity_set_weak_neighborhood mu hA hε
  obtain ⟨α, hα, htail⟩ := hWeak U hU
  refine ⟨α, hα, htail.mono (fun n hn => (measure_mono ?_).trans hn)⟩
  intro ω hω hmem
  exact not_lt_of_ge hω (hbound _ hmem)

end Concentration

end Antichain
